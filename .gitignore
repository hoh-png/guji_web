# 依赖
node_modules
server/node_modules/
server/.env

# 构建产物
dist
dist-ssr

# 本地调试与编辑器
*.local
.vite
.DS_Store
.idea
.vscode/*
!.vscode/extensions.json

# 日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 本地 npm 缓存（沙箱环境下为避免写入用户目录而重定向到项目内）
.npm-cache

# 重构保真度验证材料（原版快照、对照构建产物、截图等，可随时删除）
_original_site
_verify/original
_verify/ref
_verify/chrome-profile*
_verify/shots
_verify/*.log
