generator client {
  provider = "prisma-client-js"
}

model RelicRestoration {
  id             Int       @id @default(autoincrement())
  userId         Int
  relicId        String
  completedSteps Int       @default(0)
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, relicId])
  @@index([userId])
  @@index([relicId])
}

datasource db {
  provider = "mysql"
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  wallet       Wallet?
  profile      PlayerProfile?
  preference   PlayerPreference?
  shopItems    ShopOwnership[]
  restorations RelicRestoration[]
  quizAttempts QuizAttempt[]
  quizRewards  QuizReward[]
}

model PlayerProfile {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  nickname  String   @default("修复师")
  bio       String   @default("")
  avatarId  String   @default("avatar-ink")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PlayerPreference {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  equippedToolIds Json
  equippedVenueId String   @default("venue-1")
  equippedDeskId  String   @default("desk-1")
  equippedRelicId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum AnswerOption {
  A
  B
  C
  D
}

model Wallet {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  ingots    Int      @default(0)
  coins     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ShopOwnership {
  id        Int      @id @default(autoincrement())
  userId    Int
  itemType  String
  itemId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemId])
  @@index([userId])
}

model Question {
  id            Int          @id @default(autoincrement())
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer AnswerOption
  rewardCoins   Int          @default(0)
  rewardIngots  Int          @default(0)
  explanation   String?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  attempts QuizAttempt[]
  rewards  QuizReward[]
}

model QuizAttempt {
  id             Int          @id @default(autoincrement())
  userId         Int
  questionId     Int
  selectedAnswer AnswerOption
  isCorrect      Boolean
  rewardGranted  Boolean      @default(false)
  createdAt      DateTime     @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([questionId])
  @@index([userId, questionId])
}

model QuizReward {
  id         Int      @id @default(autoincrement())
  userId     Int
  questionId Int
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([questionId])
}
